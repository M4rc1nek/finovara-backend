<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="1-create-users" author="Marcin Parśniak">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="profile_image_path" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="2-create-wallets" author="Marcin Parśniak">
        <createTable tableName="wallets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="balance" type="DECIMAL(19,2)"/>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_wallet_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3-create-limits" author="Marcin Parśniak">
        <createTable tableName="limits">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="limit_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="limit_status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_limit_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4-create-expenses" author="Marcin Parśniak">
        <createTable tableName="expenses">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="category" type="VARCHAR(255)"/>
            <column name="created_at" type="DATE"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_expense_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="5-create-revenues" author="Marcin Parśniak">
        <createTable tableName="revenues">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="category" type="VARCHAR(255)"/>
            <column name="created_at" type="DATE"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_revenue_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="6-create-piggy_banks" author="Marcin Parśniak">
        <createTable tableName="piggy_banks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATE"/>
            <column name="goal_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="goal_amount" type="DECIMAL(19,2)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_piggybank_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="7-create-account-settings" author="Marcin Parśniak">
        <createTable tableName="account_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="forgot_password_code" type="INT"/>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_account_settings_user"
                             references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="8-create-expense-settings" author="Marcin Parśniak">
        <createTable tableName="expense_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="expense_amount_threshold_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="blocked_amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="smart_scan_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="expense_count_quantity_limit_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="number_of_quantity_limit" type="INT"/>
            <column name="count_quantity_limit_strategy" type="VARCHAR(255)"/>
            <column name="expense_quantity_limit_emergency_mode_enabled" type="BOOLEAN"/>
            <column name="expense_quantity_limit_emergency_mode_used" type="BOOLEAN"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_expense_settings_user"
                             references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="9-create-revenue-settings" author="Marcin Parśniak">
        <createTable tableName="revenue_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="recurring_revenues_enable" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="recurring_amount" type="DECIMAL(19,2)"/>
            <column name="revenue_category" type="VARCHAR(255)"/>
            <column name="recurring_strategy" type="VARCHAR(255)"/>
            <column name="recurring_start_date" type="DATE"/>
            <column name="next_execution_date" type="DATE"/>
            <column name="scoring_enable" type="BOOLEAN"/>
            <column name="revenue_points" type="DECIMAL(19,2)"/>
            <column name="created_at" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_revenue_settings_user"
                             references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="10-create-piggy-bank-settings" author="Marcin Parśniak">
        <createTable tableName="piggy_bank_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="automation_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="automation_percentage" type="DECIMAL(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="round_up_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="goal_completion_strategy" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="piggy_bank_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_piggy_bank_settings_pb"
                             references="piggy_banks(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="11-create-expense-activity" author="Marcin Parśniak">
        <createTable tableName="expense_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)"/>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="previous_amount" type="DECIMAL(19,2)"/>
            <column name="category" type="VARCHAR(255)"/>
            <column name="previous_category" type="VARCHAR(255)"/>
            <column name="date" type="TIMESTAMP"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_expense_activity_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="12-create-revenue-activity" author="Marcin Parśniak">
        <createTable tableName="revenue_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)"/>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="previous_amount" type="DECIMAL(19,2)"/>
            <column name="category" type="VARCHAR(255)"/>
            <column name="previous_category" type="VARCHAR(255)"/>
            <column name="date" type="TIMESTAMP"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_revenue_activity_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="13-create-limit-activity" author="Marcin Parśniak">
        <createTable tableName="limit_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="limit_activity_type" type="VARCHAR(255)"/>
            <column name="limit_type" type="VARCHAR(255)"/>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="previous_amount" type="DECIMAL(19,2)"/>
            <column name="date" type="TIMESTAMP"/>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_limit_activity_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="14-create-piggy-bank-activity" author="Marcin Parśniak">
        <createTable tableName="piggy_bank_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="piggy_bank_name" type="VARCHAR(255)"/>

            <column name="activity_type" type="VARCHAR(255)"/>
            <column name="goal_type" type="VARCHAR(255)"/>

            <column name="goal_amount" type="DECIMAL(19,2)"/>
            <column name="amount_paid" type="DECIMAL(19,2)"/>
            <column name="amount_paid_out" type="DECIMAL(19,2)"/>

            <column name="date" type="TIMESTAMP"/>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_piggy_bank_activity_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="15-create-login-activity" author="Marcin Parśniak">
        <createTable tableName="login_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="date" type="TIMESTAMP"/>
            <column name="browser" type="VARCHAR(255)"/>
            <column name="ip_address" type="VARCHAR(255)"/>
            <column name="location" type="VARCHAR(255)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_login_activity_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="16-create-login-activity-archive" author="Marcin Parśniak">
        <createTable tableName="login_activity_archive">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="move_to_archive_date" type="TIMESTAMP"/>
            <column name="activity_login_date" type="TIMESTAMP"/>
            <column name="browser" type="VARCHAR(255)"/>
            <column name="ip_address" type="VARCHAR(255)"/>
            <column name="location" type="VARCHAR(255)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_login_activity_archive_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="17-create-account-changes-activity" author="Marcin Parśniak">
        <createTable tableName="account_changes_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)"/>
            <column name="date" type="TIMESTAMP"/>
            <column name="browser" type="VARCHAR(255)"/>
            <column name="ip_address" type="VARCHAR(255)"/>
            <column name="location" type="VARCHAR(255)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_account_changes_activity_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="18-create-account-change-archive" author="Marcin Parśniak">
        <createTable tableName="account_change_archive">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)"/>
            <column name="move_to_archive_date" type="TIMESTAMP"/>
            <column name="activity_account_changes_date" type="TIMESTAMP"/>
            <column name="browser" type="VARCHAR(255)"/>
            <column name="ip_address" type="VARCHAR(255)"/>
            <column name="location" type="VARCHAR(255)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_account_change_archive_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-shedlock-table" author="Marcin Parśniak">
        <createTable tableName="shedlock">
            <column name="name" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lock_until" type="timestamp(3)">
                <constraints nullable="false"/>
            </column>
            <column name="locked_at" type="timestamp(3)">
                <constraints nullable="false"/>
            </column>
            <column name="locked_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>