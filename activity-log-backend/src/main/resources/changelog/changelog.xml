    </changeSet>

    <changeSet id="create-piggy-bank-activity" author="Marcin Parśniak">
        <createTable tableName="piggy_bank_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="piggy_bank_name" type="VARCHAR(255)"/>
            <column name="previous_piggy_bank_name" type="VARCHAR(255)"/>
            <column name="activity_type" type="VARCHAR(255)"/>
            <column name="goal_type" type="VARCHAR(255)"/>
            <column name="previous_goal_type" type="VARCHAR(255)"/>
            <column name="goal_amount" type="DECIMAL(19,2)"/>
            <column name="previous_goal_amount" type="DECIMAL(19,2)"/>
            <column name="amount_paid" type="DECIMAL(19,2)"/>
            <column name="amount_paid_out" type="DECIMAL(19,2)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="piggy_bank_activity" indexName="idx_piggy_bank_activity_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-settings-activity" author="Marcin Parśniak">
