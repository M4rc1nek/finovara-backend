    <changeSet id="create-account-changes-activity" author="Marcin Parśniak">
        <createTable tableName="account_change_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
