    </changeSet>

    <changeSet id="create-shared-account-change-history-activity" author="Marcin Parśniak">
        <createTable tableName="shared_account_change_history_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)"/>
            <column name="refunded_balance" type="DECIMAL(19,2)"/>
            <column name="co_founder_username" type="VARCHAR(255)"/>
            <column name="co_founder_email" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="shared_account_change_history_activity" indexName="idx_shared_account_change_history_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-shared-account-activity-log" author="Marcin Parśniak">
        <createTable tableName="shared_account_activity_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="activity_type" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="owner_id" type="BIGINT"/>
            <column name="member_id" type="BIGINT"/>
            <column name="user_id" type="BIGINT"/>
            <column name="target_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="shared_account_activity_log" indexName="idx_shared_account_activity_log_owner_created">
            <column name="owner_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
        <createIndex tableName="shared_account_activity_log" indexName="idx_shared_account_activity_log_member_created">
            <column name="member_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
        <createIndex tableName="shared_account_activity_log" indexName="idx_shared_account_activity_log_user_type_created">
            <column name="user_id"/>
            <column name="activity_type"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="shared_account_activity_log" indexName="idx_shared_account_activity_log_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-risk-operation-activity" author="Marcin Parśniak">
        <createTable tableName="risk_operation_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="source_event_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_risk_operation_activity_source_event_id"/>
            </column>
            <column name="trigger_type" type="VARCHAR(255)"/>
            <column name="score" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(255)"/>
            <column name="operation_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="risk_operation_activity" indexName="idx_risk_operation_activity_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-risk-rule-collection-activity" author="Marcin Parśniak">
        <createTable tableName="risk_rule_collection_activity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="risk_rule" type="VARCHAR(255)"/>
            <column name="score" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="risk_operation_activity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_risk_rule_collection_activity_operation"
                                 baseTableName="risk_rule_collection_activity"
                                 baseColumnNames="risk_operation_activity_id"
                                 referencedTableName="risk_operation_activity"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <createIndex tableName="risk_rule_collection_activity" indexName="idx_risk_rule_collection_activity_operation">
            <column name="risk_operation_activity_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-shedlock-table" author="Marcin Parśniak">
        <createTable tableName="shedlock">
            <column name="name" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lock_until" type="TIMESTAMP(3)">
                <constraints nullable="false"/>
            </column>
            <column name="locked_at" type="TIMESTAMP(3)">
                <constraints nullable="false"/>
            </column>
            <column name="locked_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>