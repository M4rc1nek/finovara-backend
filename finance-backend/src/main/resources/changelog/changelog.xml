<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <include file="changelog/outbox-table.xml"/>

    <changeSet id="create-wallets" author="Marcin Parśniak">
        <createTable tableName="wallets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="reserved_amount" type="DECIMAL(19,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-fund-reservation" author="Marcin Parśniak">
        <createTable tableName="fund_reservation">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="wallet_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="fund_reservation" baseColumnNames="wallet_id" constraintName="fk_fund_reservation_wallet" referencedTableName="wallets" referencedColumnNames="id"/>
        <createIndex tableName="fund_reservation" indexName="idx_fund_reservation_wallet_id_status">
            <column name="wallet_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-shared-wallets" author="Marcin Parśniak">
        <createTable tableName="shared_wallets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="member_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="shared_wallets" columnNames="owner_id, member_id"
                             constraintName="uk_shared_wallets_owner_member"/>
    </changeSet>

    <changeSet id="create-shared-notes-table" author="Marcin Parśniak">
        <createTable tableName="shared_notes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="topic" type="VARCHAR(40)">
                <constraints nullable="true"/>
            </column>
            <column name="description" type="VARCHAR(600)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="member_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-limits" author="Marcin Parśniak">
        <createTable tableName="limits">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="period_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            CREATE UNIQUE INDEX uq_limit_general ON limits(user_id, period_type) WHERE category IS NULL AND is_active =
            true;
            CREATE UNIQUE INDEX uq_limit_category ON limits(user_id, period_type, category) WHERE category IS NOT NULL
            AND is_active = true;
        </sql>
    </changeSet>
    <changeSet id="create-shared-limits" author="Marcin Parśniak">
        <createTable tableName="shared_limits">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="period_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="member_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            CREATE UNIQUE INDEX uq_shared_limit_general ON shared_limits(owner_id, member_id, period_type) WHERE
            category IS NULL AND is_active = true;
            CREATE UNIQUE INDEX uq_shared_limit_category ON shared_limits(owner_id, member_id, period_type, category)
            WHERE category IS NOT NULL AND is_active = true;
        </sql>
    </changeSet>

    <changeSet id="create-expenses" author="Marcin Parśniak">
        <createTable tableName="expenses">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="category" type="VARCHAR(255)"/>
            <column name="created_at" type="DATE"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="create-shared-expenses" author="Marcin Parśniak">
        <createTable tableName="shared_expenses">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="category" type="VARCHAR(255)"/>
            <column name="created_at" type="DATE"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="member_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <changeSet id="create-revenues" author="Marcin Parśniak">
        <createTable tableName="revenues">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="category" type="VARCHAR(255)"/>
            <column name="created_at" type="DATE"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="create-shared-revenues" author="Marcin Parśniak">
        <createTable tableName="shared_revenues">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="category" type="VARCHAR(255)"/>
            <column name="created_at" type="DATE"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="member_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-piggy_banks" author="Marcin Parśniak">
        <createTable tableName="piggybanks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATE"/>
            <column name="goal_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="goal_amount" type="DECIMAL(19,2)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            CREATE UNIQUE INDEX unique_piggy_bank_user_name
            ON piggybanks (user_id, LOWER(name));
        </sql>
    </changeSet>
    <changeSet id="create-shared-piggy_banks" author="Marcin Parśniak">
        <createTable tableName="shared_piggybanks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATE"/>
            <column name="goal_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="goal_amount" type="DECIMAL(19,2)"/>
            <column name="goal_achieved_notified" type="BOOLEAN">
                <constraints nullable="true"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="member_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            CREATE UNIQUE INDEX unique_shared_piggy_bank_name
            ON shared_piggybanks (owner_id, member_id, LOWER(name));
        </sql>
    </changeSet>
    <changeSet id="create-goalplanner" author="Marcin Parśniak">
        <createTable tableName="goalplanner">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="topic" type="VARCHAR(255)"/>
            <column name="target_date" type="DATE"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="piggy_bank_id" type="BIGINT">
                <constraints nullable="true" unique="true" foreignKeyName="fk_goalplanner_piggybank" references="piggybanks(id)"/>
            </column>
        </createTable>
        <createIndex tableName="goalplanner" indexName="idx_goalplanner_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="create-expense-settings" author="Marcin Parśniak">
        <createTable tableName="expense_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount_threshold_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="blocked_amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="smart_scan_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="count_quantity_limit_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="number_of_quantity_limit" type="INT"/>
            <column name="count_quantity_limit_period" type="VARCHAR(255)"/>
            <column name="quantity_limit_emergency_mode_enabled" type="BOOLEAN"/>
            <column name="quantity_limit_emergency_mode_used" type="BOOLEAN"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-recurring-settings" author="Marcin Parśniak">
        <createTable tableName="recurring_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="enable" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="type" type="VARCHAR(255)"/>
            <column name="revenue_category" type="VARCHAR(255)"/>
            <column name="expense_category" type="VARCHAR(255)"/>
            <column name="recurring_period" type="VARCHAR(255)"/>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="next_execution_date" type="DATE"/>
            <column name="skipped_notification_sent" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="piggy_bank_id" type="BIGINT"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-piggy-bank-settings" author="Marcin Parśniak">
        <createTable tableName="piggy_bank_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="automation_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="automation_percentage" type="DECIMAL(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="round_up_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="goal_completion_strategy" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="piggy_bank_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_piggy_bank_settings_pb"
                             references="piggybanks(id)"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="create-shared-settings" author="Marcin Parśniak">
        <createTable tableName="shared_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="spend_control_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="spend_control_percentage" type="DECIMAL(5,2)">
                <constraints nullable="true"/>
            </column>
            <column name="expense_analysis_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="large_expense_notification_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="large_expense_notification_threshold" type="DECIMAL(19,2)">
                <constraints nullable="true"/>
            </column>
            <column name="piggy_bank_goal_achieved_notification_enabled" type="BOOLEAN">
                <constraints nullable="true"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="member_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="shared_settings" columnNames="owner_id, member_id"
                             constraintName="uk_shared_settings_owner_member"/>
    </changeSet>
    <changeSet id="create-shedlock-table" author="Marcin Parśniak">
        <createTable tableName="shedlock">
            <column name="name" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lock_until" type="timestamp(3)">
                <constraints nullable="false"/>
            </column>
            <column name="locked_at" type="timestamp(3)">
                <constraints nullable="false"/>
            </column>
            <column name="locked_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-shared-tables-owner-member-indexes" author="Marcin Parśniak">
        <createIndex tableName="shared_wallets" indexName="idx_shared_wallets_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="shared_wallets" indexName="idx_shared_wallets_member_id">
            <column name="member_id"/>
        </createIndex>
        <createIndex tableName="shared_revenues" indexName="idx_shared_revenues_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="shared_revenues" indexName="idx_shared_revenues_member_id">
            <column name="member_id"/>
        </createIndex>

        <createIndex tableName="shared_expenses" indexName="idx_shared_expenses_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="shared_expenses" indexName="idx_shared_expenses_member_id">
            <column name="member_id"/>
        </createIndex>
        <createIndex tableName="shared_piggybanks" indexName="idx_shared_piggybanks_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="shared_piggybanks" indexName="idx_shared_piggybanks_member_id">
            <column name="member_id"/>
        </createIndex>
        <createIndex tableName="shared_limits" indexName="idx_shared_limits_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="shared_limits" indexName="idx_shared_limits_member_id">
            <column name="member_id"/>
        </createIndex>
        <createIndex tableName="shared_notes" indexName="idx_shared_notes_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="shared_notes" indexName="idx_shared_notes_member_id">
            <column name="member_id"/>
        </createIndex>
        <createIndex tableName="shared_settings" indexName="idx_shared_settings_owner_id">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="shared_settings" indexName="idx_shared_settings_member_id">
            <column name="member_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>